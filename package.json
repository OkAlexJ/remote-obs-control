{
  "name": "remote-obs-control",
  "version": "1.0.0",
  "description": "Remote OBS Control — desktop app with profiles, soundboard, and OBS WebSocket control",
  "main": "main.js",
  "author": "You",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis",
    "build:win-portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.remoteobscontrol.app",
    "productName": "Remote OBS Control",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Remote OBS Control"
    }
  }
}
